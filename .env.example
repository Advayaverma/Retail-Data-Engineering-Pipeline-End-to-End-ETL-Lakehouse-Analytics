# Environment Configuration for Retail Data Engineering Pipeline

# Pipeline Environment: local | test | production
PIPELINE_ENV=local
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=retail_secure_pass_2027
POSTGRES_DB=retail_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Lakehouse Paths (Local or Cloud URIs)
DATA_RAW_DIR=./data/raw
DATA_BRONZE_DIR=./data/bronze
DATA_SILVER_DIR=./data/silver
DATA_GOLD_DIR=./data/gold
DATA_QUARANTINE_DIR=./data/quarantine

# REST API Ingestion
MOCK_API_PORT=8000
EXCHANGE_RATE_API_URL=http://localhost:8000/api/v1/rates

# Spark Configuration
SPARK_APP_NAME=RetailLakehousePipeline
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
